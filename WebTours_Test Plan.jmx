              <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="BeanShell PostProcessor" enabled="true">
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <boolProp name="resetInterpreter">false</boolProp>
                <stringProp name="script">City = vars.get(&quot;C_departurecity&quot;);

F  = new FileOutputStream(&quot;D:/vinod314.csv&quot;,true);

p = new PrintStream(F);

this.interpreter.setOut(p);

print(&quot;The departure city is : &quot; +City);

F.close();

Destination = vars.get(&quot;C_destinationcity&quot;);

G  = new FileOutputStream(&quot;D:/vinod314.csv&quot;,true);

A = new PrintStream(G);

this.interpreter.setOut(A);

print(&quot;The Destination city is : &quot; +Destination);
print(&quot;\n&quot;);
G.close();

if(City.equals(Destination)){
	log.info(&quot;can&apos;t book the ticket&quot;);
}else{
	log.info(&quot;Book the ticket&quot;);
}</stringProp>
              </BeanShellPostProcessor>
